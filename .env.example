# WaveSpeed API key (https://wavespeed.ai/accesskey). Not needed when MOCK_WAN=true.
WAVESPEED_API_KEY=
# Public HTTPS URL of this app (used in QR codes and share links). No trailing slash.
BASE_URL=https://moment.example.com
# PIN operators type on /login. Changing it logs out every device.
OPERATOR_PIN=
# Wan tasks running at once across all visitors (3 per visitor). Must not exceed your WaveSpeed
# account's concurrent-task limit (Bronze = 2, Silver = 300).
MAX_CONCURRENT_WAN_JOBS=6
# ffmpeg renders at once (each takes ~5-15 s on 8 cores).
MAX_CONCURRENT_FFMPEG=4
# true = no API calls; the raw template clips stand in for the swapped clips.
MOCK_WAN=false

# Optional tuning (defaults shown)
# WAN_RESOLUTION=720p          # 480p halves the cost
# WAN_PROMPT=
# WAN_TIMEOUT_S=1200           # give up on a Wan task after this long (counts as a failed attempt)
# BLUR_THRESHOLD=40            # photo sharpness minimum; the rejection message shows the measured value
# MIN_PHOTO_SIDE=480
# MAX_UPLOAD_MB=15
# SESSION_SECRET=              # default: random key stored in data/session.key
# DATA_DIR=./data
# ASSETS_DIR=./assets
